# Vorlage für cockpit.env — Zugangsdaten für die Cockpit-Aktualisierung (docs/cockpit.md)
#
# Anleitung:
#   1. Diese Datei kopieren nach "cockpit.env" (Repo-Wurzel)
#   2. Die Platzhalter durch deine echten Werte ersetzen
#   3. "cockpit.env" NIEMALS committen — sie steht in der .gitignore
#
# Woher die Werte kommen:
#   LEO_EMS_HOST     IP:Port des Add-ons im LAN — die HA-IP ist 192.168.178.150,
#                    der Add-on-Port ist 8099 (config.yaml)
#   LEO_EMS_TOKEN    API-Token aus dem Add-on-Log beim ersten Start
#                    (oder per SSH: cat /data/api_token im Add-on-Container;
#                    Rotation: Datei löschen + Add-on neu starten)

LEO_EMS_HOST=192.168.178.150:8099
LEO_EMS_TOKEN=hier-den-token-aus-dem-addon-log-eintragen
